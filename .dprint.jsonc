{
  // davidfuzju: AGENTS.md is ours and written in Chinese; dprint's wrapping does
  // not suit it.
  "excludes": ["AGENTS.md", "CLAUDE.md"],
  "markdown": {
    "hardBreakKind": "doubleSpace",
    "lineWidth": 79,
    "strongKind": "underscores",
    "textWrap": "always",
    "wrapCodeSpans": false
  },
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.29.0.wasm"
  ]
}
